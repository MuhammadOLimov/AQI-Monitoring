# ============================================================
# Air Pollution Monitor - Environment Variables Example
# Copy this file to .env and fill in your actual values
# ============================================================

# Application
APP_NAME="Air Pollution Monitor"
APP_VERSION="1.0.0"
APP_ENV="production"    # development | production | testing
DEBUG=false
SECRET_KEY="replace-with-secure-random-string-at-least-32-chars"
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=4
RELOAD=false

# Database - PostgreSQL
# Use 'db' as hostname when running inside Docker Compose
DATABASE_URL="postgresql+asyncpg://postgres:strongpassword123@db:5432/air_pollution_db"
DATABASE_SYNC_URL="postgresql://postgres:strongpassword123@db:5432/air_pollution_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# Redis (for caching & Celery)
# Use 'redis' as hostname when running inside Docker Compose
REDIS_URL="redis://redis:6379/0"
CACHE_TTL=300   # seconds

# ============================================================
# External APIs
# ============================================================

# OpenWeatherMap API - Get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=YOUR_API_KEY
OPENWEATHER_BASE_URL="http://api.openweathermap.org/data/2.5/air_pollution"

# ============================================================
# Notification Services
# ============================================================

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_app_password_here"
SMTP_TLS=true
ALERT_EMAIL_FROM="noreply@yourapp.com"
ALERT_EMAIL_TO="admin@yourapp.com"
EMAIL_ALERTS_ENABLED=false

# ============================================================
# Alert Thresholds
# ============================================================
AQI_ALERT_THRESHOLD=100      # Send alert when AQI exceeds this
AQI_CRITICAL_THRESHOLD=200   # Send critical alert

# ============================================================
# Data Collection
# ============================================================
DATA_FETCH_INTERVAL=1800     # seconds (30 minutes)
AUTO_FETCH_CITIES="Tashkent,Samarkand,Bukhara,Fergana,Andijan,Namangan,Navoiy,Urgench,Nukus,Qarshi,Termiz,Jizzax,Guliston,Olmaliq,Chirchiq,Angren,Bekobod,Margilan,Kokand,Denov,Shahrisabz,Zarafshon,Xiva"

# ============================================================
# CORS
# ============================================================
# List allowed frontend origins separated by commas
CORS_ORIGINS="http://localhost,https://yourdomain.com"
CORS_ALLOW_ALL=false

# ============================================================
# Admin
# ============================================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="set_a_strong_password_here"
ADMIN_EMAIL="admin@yourapp.com"

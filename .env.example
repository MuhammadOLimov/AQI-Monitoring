# ============================================================
# Air Pollution Monitor - Environment Variables Example
# Copy this file to .env and fill in your actual values
# ============================================================

# Application
APP_NAME="Air Pollution Monitor"
APP_VERSION="1.0.0"
APP_ENV="development"    # development | production | testing
DEBUG=true
SECRET_KEY="your-super-secret-key-min-32-chars-change-this"
API_V1_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=4
RELOAD=true

# Database - PostgreSQL
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/air_pollution_db"
DATABASE_SYNC_URL="postgresql://postgres:password@localhost:5432/air_pollution_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis (for caching & Celery)
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL=300   # seconds

# ============================================================
# External APIs
# ============================================================

# OpenWeatherMap API - Get free key at https://openweathermap.org/api
OPENWEATHER_API_KEY="your_openweathermap_api_key_here"
OPENWEATHER_BASE_URL="http://api.openweathermap.org/data/2.5/air_pollution"

# ============================================================
# Notification Services
# ============================================================

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME="your_email@gmail.com"
SMTP_PASSWORD="your_app_password_here"
SMTP_TLS=true
ALERT_EMAIL_FROM="noreply@yourapp.com"
ALERT_EMAIL_TO="admin@yourapp.com"
EMAIL_ALERTS_ENABLED=true

# ============================================================
# Alert Thresholds
# ============================================================
AQI_ALERT_THRESHOLD=100      # Send alert when AQI exceeds this
AQI_CRITICAL_THRESHOLD=200   # Send critical alert

# ============================================================
# Data Collection
# ============================================================
DATA_FETCH_INTERVAL=1800     # seconds (30 minutes)
AUTO_FETCH_CITIES="Tashkent,Moscow,London,New York,Beijing,Tokyo,Dubai"

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
CORS_ALLOW_ALL=true

# ============================================================
# Admin
# ============================================================
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change_this_strong_password"
ADMIN_EMAIL="admin@yourapp.com"
